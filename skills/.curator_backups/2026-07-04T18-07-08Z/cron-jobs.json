      "id": "a5676ec61494",
      "name": "\u4ea4\u6613\u65e5\u5386-Tushare\u540c\u6b65",
      "prompt": "\u6267\u884c\u4ee5\u4e0b Python \u811a\u672c\uff0c\u4ece Tushare trade_cal API \u540c\u6b65 A\u80a1\u4ea4\u6613\u65e5\u5386\u5230 stock_data.db\uff1a\n\n1. \u8fd0\u884c\uff1a\n   cd ~/my_quant_system && ~/.pyenv/versions/3.11.11/bin/python3 -c \"\nimport sqlite3, os, time\nfrom datetime import datetime\nimport tushare as ts\n\ntoken = os.environ.get('TUSHARE_TOKEN', '')\nif not token:\n    env_file = os.path.expanduser('~/.hermes/.env.tushare')\n    if os.path.exists(env_file):\n        with open(env_file) as f:\n            for line in f:\n                line = line.strip()\n                if line.startswith('TUSHARE_TOKEN='):\n                    token = line.split('=', 1)[1].strip().strip('\\\"')\n                    break\nts.set_token(token)\npro = ts.pro_api()\n\nDB = os.path.expanduser('~/my_quant_system/stock_data.db')\nconn = sqlite3.connect(DB)\n\n# \u83b7\u53d6\u6700\u65b0\u5df2\u6709\u65e5\u671f\nlast = conn.execute('SELECT MAX(cal_date) FROM trade_cal').fetchone()[0]\nstart = last if last else '19901201'\nend = datetime.now().strftime('%Y%m%d')\n\ncount = 0\nfor ex in ['SSE', 'SZSE']:\n    df = pro.trade_cal(exchange=ex, start_date=start, end_date=end)\n    time.sleep(0.5)\n    if df is not None and not df.empty:\n        new_rows = 0\n        for _, row in df.iterrows():\n            conn.execute(\n                'INSERT OR REPLACE INTO trade_cal (exchange, cal_date, is_open, pretrade_date) VALUES (?, ?, ?, ?)',\n                (row['exchange'], row['cal_date'], row['is_open'], row.get('pretrade_date'))\n            )\n            new_rows += 1\n        conn.commit()\n        count += new_rows\nconn.close()\nprint(f'\u4ea4\u6613\u65e5\u5386\u540c\u6b65\u5b8c\u6210\uff1a\u65b0\u589e/\u66f4\u65b0 {count} \u6761\u8bb0\u5f55')\n\"\n\n2. \u6253\u5370\u7ed3\u679c\u6458\u8981\uff0c\u5305\u62ec\u6700\u65b0\u65e5\u671f\u548c\u4e0b\u4e00\u4ea4\u6613\u65e5\u4fe1\u606f\u3002",
